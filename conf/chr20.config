// Resources for a ~30x chr20 run (use with -profile awsbatch,chr20). The toy defaults in
// awsbatch.config are far too small for this. The GATK modules set no Java options, so a JVM
// only gets 25% of its container's memory unless we raise that.
env.JAVA_TOOL_OPTIONS = '-XX:MaxRAMPercentage=75.0'

process {
    withName: 'BWAMEM2_MEM'          { cpus = 8; memory = '16 GB' }
    withName: 'SAMTOOLS_SORT'        { cpus = 4; memory = '8 GB' }
    withName: 'GATK_MARKDUPLICATES'  { cpus = 2; memory = '16 GB' }
    withName: 'GATK_BASERECALIBRATOR|GATK_APPLYBQSR|GATK_HAPLOTYPECALLER' { cpus = 2; memory = '16 GB' }
    withName: 'GATK_GENOTYPEGVCFS|GATK_HARDFILTER' { cpus = 2; memory = '8 GB' }
    withName: 'RTG_VCFEVAL'          { cpus = 2; memory = '8 GB' }
}
