// Every container image the pipeline uses, pinned, in one place. Declared here (not in the
// modules) so Nextflow reports them as `workflow.container`, which the benchmark metrics
// record includes for provenance.
process {
    withName: 'BWAMEM2_.*'        { container = 'quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0' }
    withName: 'SAMTOOLS_.*'       { container = 'quay.io/biocontainers/samtools:1.24--h9dcdb79_1' }
    withName: 'GATK_.*'           { container = 'quay.io/biocontainers/gatk4:4.6.2.0--py310hdfd78af_1' }
    withName: 'RTG_.*'            { container = 'quay.io/biocontainers/rtg-tools:3.13--hdfd78af_0' }
    withName: 'BENCHMARK_.*'      { container = 'python:3.12.15-slim-bookworm' }
}
