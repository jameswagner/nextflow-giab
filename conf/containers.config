// Every container image the pipeline uses, in one place, pinned by digest (name@sha256:...). The digest
// is what is pulled, and a registry cannot change it afterwards; the comment on each line names the tag it was
// taken from. (Nextflow rejects the combined tag@digest form.)
// Declared here (not in the modules) so Nextflow reports them as `workflow.container`, which the
// benchmark metrics record includes for provenance. Refresh digests with scripts/pin_images.py.
process {
    withName: 'BWAMEM2_.*'        { container = 'quay.io/biocontainers/bwa-mem2@sha256:374f4b910b4b04d32772fccd4cab1cdcd0758356856a960cfa8b1edebfd38c9f' }  // quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0
    withName: 'SAMTOOLS_.*'       { container = 'quay.io/biocontainers/samtools@sha256:a130447589651ed09252aa95a5e4f4132942cdb54d835d81a04a9a930d656561' }  // quay.io/biocontainers/samtools:1.24--h9dcdb79_1
    withName: 'PREP_.*'           { container = 'quay.io/biocontainers/samtools@sha256:a130447589651ed09252aa95a5e4f4132942cdb54d835d81a04a9a930d656561' }  // quay.io/biocontainers/samtools:1.24--h9dcdb79_1
    withName: 'GATK_.*'           { container = 'quay.io/biocontainers/gatk4@sha256:7311332e4d565d2356bbc0540cf582b505d1969a5f088a2c065302b13b10f5ee' }  // quay.io/biocontainers/gatk4:4.6.2.0--py310hdfd78af_1
    withName: 'RTG_.*'            { container = 'quay.io/biocontainers/rtg-tools@sha256:6a85ea03bdb8b30ae6a10f01e9eb0a35dd0dcf66438d988dd5f65e11786b6d98' }  // quay.io/biocontainers/rtg-tools:3.13--hdfd78af_0
    withName: 'BENCHMARK_.*'      { container = 'python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258' }  // python:3.12.15-slim-bookworm
}
