// Run tasks on AWS Batch (Spot). Queue and job role come from the CDK stack outputs,
// passed as environment variables so no account-specific values live in the repo:
//   export GIAB_BATCH_QUEUE=<JobQueueName>   GIAB_JOB_ROLE=<JobRoleArn>
// Work dir goes on the command line: -work-dir s3://<BucketName>/work
process.executor  = 'awsbatch'
process.queue     = System.getenv('GIAB_BATCH_QUEUE')
// Modules declare no resources and Batch's defaults are too small for GATK; sized for the toy data.
process.cpus      = 2
process.memory    = '6 GB'

// Tags every worker job; the launcher role may cancel only jobs with this tag (infra/lib/infra-stack.ts).
process.resourceLabels = [project: 'nextflow-giab']

aws.region        = 'us-east-1'
aws.batch.jobRole = System.getenv('GIAB_JOB_ROLE')
// CDK-owned group with 30-day retention and the error metric filter (infra/).
aws.batch.logsGroup = '/giab/batch-jobs'
// AWS CLI installed on each instance by the compute environment's launch template (see infra/).
aws.batch.cliPath = '/opt/miniconda/bin/aws'
// Spot workers can be reclaimed by AWS mid-step. Retry only those interruptions (not real task
// failures), and retry flaky S3 transfers. maxSpotAttempts defaults to 0 since Nextflow 24.10.
aws.batch.maxSpotAttempts     = 3
aws.batch.maxTransferAttempts = 3
