// Run tasks on AWS Batch (Spot). Queue and job role come from the CDK stack outputs,
// passed as environment variables so no account-specific values live in the repo:
//   export GIAB_BATCH_QUEUE=<JobQueueName>   GIAB_JOB_ROLE=<JobRoleArn>
// Work dir goes on the command line: -work-dir s3://<BucketName>/work
process.executor  = 'awsbatch'
process.queue     = System.getenv('GIAB_BATCH_QUEUE')

aws.region        = 'us-east-1'
aws.batch.jobRole = System.getenv('GIAB_JOB_ROLE')
// AWS CLI installed on each instance by the compute environment's launch template (see infra/).
aws.batch.cliPath = '/opt/miniconda/bin/aws'
