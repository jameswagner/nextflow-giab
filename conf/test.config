// Toy data (nf-core test-datasets). Expects the repo's data_dir layout under test-data/;
// override the location with --test_data <dir-or-s3-uri>.
params.test_data = "${projectDir}/test-data"

params.samplesheet = "${projectDir}/assets/samplesheet.test.csv"
params.fasta       = "${params.test_data}/genome/genome.fasta"
params.dbsnp       = "${params.test_data}/genome/vcf/dbsnp_146.hg38.vcf.gz"
params.dbsnp_tbi   = "${params.test_data}/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi"
params.mills       = "${params.test_data}/genome/vcf/mills_and_1000G.indels.vcf.gz"
params.mills_tbi   = "${params.test_data}/genome/vcf/mills_and_1000G.indels.vcf.gz.tbi"
